# ==============================================================================
# LexisGraph — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Settings
APP_NAME=LexisGraph
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Primary LLM Provider: Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3

# Optional Fallback LLM: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector Database: Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=lexisgraph_legal_documents
QDRANT_VECTOR_DIM=128
QDRANT_USE_HTTPS=false

# Knowledge Graph: Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=legalgraphpassword123
NEO4J_DATABASE=neo4j

# ColPali & Embedding Configuration
COLPALI_MODEL_NAME=vidore/colpali-v1.3-hf
COLPALI_DEVICE=auto
COLPALI_BATCH_SIZE=4
COLPALI_DPI=200

# Security & Presidio PII Masking
PRESIDIO_ENABLED=true
PRESIDIO_DEFAULT_LANG=ar
PRESIDIO_SPACY_MODEL=xx_ent_wiki_sm
PRESIDIO_MASKING_CHAR=*
NEMO_GUARDRAILS_ENABLED=true

# BM25 Keyword Search
BM25_TOP_K=10
RRF_K_CONSTANT=60

# Document Storage & AWS (Production)
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./data/documents
AWS_REGION=us-east-1
S3_BUCKET_NAME=lexisgraph-legal-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
